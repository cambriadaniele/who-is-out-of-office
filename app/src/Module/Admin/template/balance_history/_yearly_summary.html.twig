{# Fork: one card per leave year. The ledger below is a single running account. #}
{% if yearly_balance is defined and yearly_balance and (selected_period is null or selected_period.isOpen) %}
    <div class="year-balance-grid">
        <div class="year-balance-card year-balance-card-current">
            <div class="year-balance-year">{{ yearly_balance.currentYear }} <span class="year-balance-tag">{{ 'balance_history.yearly.tag_current'|trans(domain: 'admin') }}</span></div>
            <div class="year-balance-free">
                <strong>{{ yearly_balance.currentRemaining }}</strong>
                <span>{{ 'balance_history.yearly.free'|trans(domain: 'admin') }}</span>
            </div>
        </div>
        {% for row in yearly_balance.future %}
            <div class="year-balance-card">
                <div class="year-balance-year">{{ row.year }}</div>
                <dl class="year-balance-rows">
                    <dt>{{ 'balance_history.yearly.allowance'|trans(domain: 'admin') }}</dt><dd>+{{ row.allowance }}</dd>
                    <dt>{{ 'balance_history.yearly.booked'|trans(domain: 'admin') }}</dt><dd>&minus;{{ row.booked }}</dd>
                </dl>
                <div class="year-balance-free">
                    <strong>{{ row.remaining }}</strong>
                    <span>{{ 'balance_history.yearly.free'|trans(domain: 'admin') }}</span>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
